# backend/.env.example
# คัดลอกไฟล์นี้เป็น backend/.env แล้วกรอกค่าจริง
# ห้าม commit ไฟล์ .env ขึ้น git (.gitignore กันไว้แล้ว)

# ------------------------------------------------------------
# ฐานข้อมูล — ตอนพัฒนาใช้ MySQL ในเครื่อง
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fixbot

# ใบรับรอง TLS — เว้นว่างไว้ตอนใช้ MySQL ในเครื่อง
# ตอน deploy ให้วางเนื้อหาไฟล์ ca.pem ที่ดาวน์โหลดจากผู้ให้บริการลงตรงนี้
DB_SSL_CA=

# ------------------------------------------------------------
# เซิร์ฟเวอร์
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# ค้นหาอาการด้วยภาษาธรรมชาติ (โหลดโมเดล ใช้ RAM ราว 250-300 MB)
# ------------------------------------------------------------
# ต้องเป็น true เป๊ะๆ จึงโหลดโมเดล ค่าอื่นหรือเว้นว่าง = ปิด
# ปิดอยู่เซิร์ฟเวอร์ส่วนที่เหลือทำงานปกติ ผู้ใช้เลือกอาการจากรายการได้เหมือนเดิม
# ดูสถานะและหน่วยความจำได้ที่ GET /symptom-search/status
SYMPTOM_SEARCH_ENABLED=false

# (ตอน deploy บน Linux เช่น Render) ตั้งตัวแปรนี้ให้ขั้นติดตั้งแพ็กเกจ ไม่ใช่ใน .env:
#   ONNXRUNTIME_NODE_INSTALL=skip
# ไม่ตั้ง = onnxruntime-node ดาวน์โหลดไลบรารี CUDA ที่ CPU ไม่ใช้ เสียเวลาและดิสก์

# ------------------------------------------------------------
# LLM — ยังไม่ได้ใช้ (ชั้นเรียบเรียงถ้อยคำ ยังไม่ได้ทำ)
# ------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=